# NIPOST Digital Postcode API
# Docs:      https://docs.postcode.gov.ng
# Dashboard: https://dashboard.postcode.gov.ng  (Settings → API Keys)
#
# Copy this file to `.env` in this folder (PostBatch-HQ/.env) and paste your key.
# The key is used ONLY by the Vite dev server proxy (/nipost → api.postcode.gov.ng);
# it is never sent to the browser. Do NOT prefix it with VITE_.
#
# Key types: nipost_test_… (sandbox, recommended for the demo)
#            nipost_pk_test_… (publishable, sandbox)
#            nipost_live_… / nipost_pk_live_… (production, needs verified KYB)
NIPOST_API_KEY=nipost_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Highest lookup level your key is granted (1 = validity only, free).
# Run `npm run nipost:check` to find out.
NIPOST_LOOKUP_LEVEL=1
