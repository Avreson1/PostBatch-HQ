{
  "name": "postbatch-hq",
  "version": "0.1.0",
  "private": true,
  "description": "B2B logistics clustering engine & checkout SDK built on the NIPOST Digital Postcode API",
  "workspaces": [
    "postbatch-widget",
    "postbatch-engine",
    "postbatch-demo"
  ],
  "scripts": {
    "widget": "npm run dev --workspace=postbatch-widget",
    "engine": "npm run start --workspace=postbatch-engine",
    "demo": "npm run dev --workspace=postbatch-demo",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "nipost:check": "node scripts/check-nipost.mjs"
  },
  "keywords": [
    "logistics",
    "nipost",
    "postcode",
    "clustering",
    "b2b"
  ],
  "author": "PostBatch Technologies Ltd.",
  "license": "UNLICENSED"
}
